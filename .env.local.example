# このファイルをコピーして .env.local を作り、実際の値を入れてください。
# .env.local はコミットされません(.gitignoreで除外済み)。

# --- Supabase ---
# ブラウザからも使う値(公開して問題ないもの)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用・強い権限を持つ秘密鍵。RLSを無視してapp_dataテーブル/invoicesバケットを読み書きする。
# 絶対にNEXT_PUBLIC_を付けない・ブラウザに渡さない・人に見せない。
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Anthropic Claude) ---
# サーバー側(Next.jsのAPI Route)からのみ使う想定。NEXT_PUBLIC_を付けないことでブラウザに露出しません。
ANTHROPIC_API_KEY=

# ============================================================
# あすか（人事・採用担当）
# ============================================================
# 【音声対話】
# 応募者との会話・追加質問
ASUKA_REALTIME_MODEL=gpt-realtime-2.1

# 【面接レポート・100点評価】
# 面接内容と採用基準から点数を作成
ASUKA_REPORT_MODEL=gpt-5.6-luna

# オフィス・スタッフへの指示内容を低コストで理解するモデル
OFFICE_ROUTER_MODEL=gpt-5.6-luna

# あすか用OpenAI APIキー（音声対話・レポートで共通）
OPENAI_API_KEY=

# ============================================================
# みさき（経理）— 請求書の自動送信
# ============================================================
# 【メール送信】Resend (https://resend.com) のAPIキー。無料枠あり。
RESEND_API_KEY=
# 送信元メールアドレス（Resendで認証済みのドメイン、または onboarding@resend.dev で仮運用可）
INVOICE_EMAIL_FROM=

# 【LINE送受信】LINE Developersで作成したMessaging APIチャネル（みさき用）
LINE_CHANNEL_ID=
# Webhookの署名検証に使う（「チャネル基本設定」タブに表示）
LINE_CHANNEL_SECRET=
# メッセージ送信に使う（「Messaging API設定」タブの「チャネルアクセストークン(長期)」を発行）
LINE_CHANNEL_ACCESS_TOKEN=
# LINEの画像メッセージは公開HTTPSのURLが必須。localhostでは送れないため、
# Vercelなどにデプロイした後の公開URL、またはngrok等のトンネルURLを入れる。
PUBLIC_BASE_URL=

# 【Googleカレンダー】撮影日程の空き確認・予定登録
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=ryoshin000@gmail.com
OFFICE_ACCESS_USER=kobayashi
OFFICE_ACCESS_PASSWORD=
